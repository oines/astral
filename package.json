{
  "name": "astral",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "pnpm --filter @astral/web dev",
    "dev:server": "go run ./cmd/astral serve",
    "dev:desktop": "pnpm --filter @astral/desktop dev",
    "build": "pnpm openapi-generate && pnpm sdk-generate && pnpm --filter @astral/web build && node scripts/build-server.mjs",
    "build:distribution": "node scripts/build-distribution.mjs",
    "build:desktop": "pnpm build:distribution && pnpm --filter @astral/desktop build",
    "build:icons": "node scripts/build-icons.mjs",
    "lint": "eslint .",
    "lint:go": "golangci-lint run",
    "typecheck": "pnpm --filter @astral/web typecheck && pnpm --filter @astral/desktop typecheck",
    "test": "vitest run",
    "test:integration": "go test -race -tags=integration -count=1 -timeout=20m ./internal/platform",
    "test:desktop-service": "node scripts/check-desktop-service.mjs",
    "test:packaged-desktop": "node scripts/check-packaged-desktop.mjs",
    "test:daemon-service": "node scripts/check-daemon-service.mjs",
    "openapi-generate": "go run ./cmd/openapi",
    "sdk-generate": "openapi-ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^25.9.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "bumpp": "^10.4.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1"
  },
  "lint-staged": {
    "*.{vue,js,mjs,ts}": "eslint --fix"
  },
  "license": "AGPL-3.0-only"
}
