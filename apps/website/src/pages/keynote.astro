            </div>

            <div class="closing-qrs">
              <div class="qr-card">
                <div class="qr-box">
                  <svg viewBox={`0 0 ${siteQr.size} ${siteQr.size}`} shape-rendering="crispEdges" role="img" aria-label="Astral 官网二维码">
                    <path d={siteQr.path} fill="#1a1a18" />
                  </svg>
                </div>
                <span class="qr-label">astral.oines.dev</span>
              </div>
              <div class="qr-card">
                <div class="qr-box">
                  <svg viewBox={`0 0 ${repoQr.size} ${repoQr.size}`} shape-rendering="crispEdges" role="img" aria-label="Astral GitHub 仓库二维码">
                    <path d={repoQr.path} fill="#1a1a18" />
