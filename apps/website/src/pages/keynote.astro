      </div>
    </main>

    <button type="button" class="edge-nav edge-nav-prev" id="edge-prev" aria-label="上一页"></button>
    <button type="button" class="edge-nav edge-nav-next" id="edge-next" aria-label="下一页"></button>

    <div class="deck-hud" aria-label="演示控制栏">
      <div class="hud-group">
        <button type="button" class="hud-btn" id="btn-prev" aria-label="上一页"><ArrowLeft size={14} /></button>
        <span class="hud-counter" id="hud-counter">01 / 13</span>
        <button type="button" class="hud-btn" id="btn-next" aria-label="下一页"><ArrowRight size={14} /></button>
      </div>
      <div class="hud-group">
        <button type="button" class="hud-btn" id="btn-grid" title="页面总览 (G)"><LayoutGrid size={14} /><span>总览</span></button>
        <span class="hud-sep" aria-hidden="true"></span>
        <button type="button" class="hud-btn" id="btn-full" title="全屏演示 (F)"><Maximize2 size={14} /></button>
      </div>
    </div>

    <div class="deck-progress" aria-hidden="true">
      <div class="deck-progress-bar" id="progress-bar"></div>
    </div>

    <div class="deck-overview" id="deck-overview" data-open="false" role="dialog" aria-modal="true" aria-label="页面总览">
      <div class="overview-head">
        <span>Astral 产品演示 · 选择页面跳转（Esc 关闭 · T 切换深浅色）</span>
        <button type="button" class="hud-btn" id="btn-overview-close">关闭</button>
      </div>
      <div class="overview-grid">
        {overviewItems.map((item, index) => (
          <button type="button" class="overview-card" data-jump={index + 1} data-current={index === 0 ? 'true' : 'false'}>
            <span class="overview-num">{item.num}</span>
            <div>
              <div class="overview-label">{item.title}</div>
              <div class="overview-hint">{item.hint}</div>
            </div>
          </button>
        ))}
      </div>
    </div>

    <script>
      const stage = document.getElementById('deck-stage');
      const slides = [...document.querySelectorAll<HTMLElement>('.slide')];
      const total = slides.length;
      const counter = document.getElementById('hud-counter');
      const progressBar = document.getElementById('progress-bar');
      const btnPrev = document.getElementById('btn-prev') as HTMLButtonElement | null;
      const btnNext = document.getElementById('btn-next') as HTMLButtonElement | null;
      const overview = document.getElementById('deck-overview');
      const jumpButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-jump]')];

      let current = 0;

      function fitStage() {
        if (!stage) return;
        const vw = window.visualViewport?.width ?? window.innerWidth;
        const vh = window.visualViewport?.height ?? window.innerHeight;
        const scale = Math.min(vw / 1600, vh / 900);
        stage.style.setProperty('--deck-scale', String(scale));
      }
      fitStage();
      window.addEventListener('resize', fitStage);
      window.addEventListener('orientationchange', fitStage);
      window.visualViewport?.addEventListener('resize', fitStage);

      const durations = [2600, 3200, 3400, 5200];

      type CinemaController = {
        start: () => void;
        stop: () => void;
        toggle: () => void;
        replay: () => void;
      };

      const cinemas = new Map<HTMLElement, CinemaController>();

      for (const el of document.querySelectorAll<HTMLElement>('[data-cinema]')) {
        const dots = [...el.querySelectorAll<HTMLElement>('.demo-dots i')];
        const iconPause = el.querySelector<HTMLElement>('.icon-pause');
        const iconPlay = el.querySelector<HTMLElement>('.icon-play');
        let phase = 0;
        let paused = false;
        let timer: number | undefined;

        const sync = () => {
          el.dataset.phase = String(phase);
          dots.forEach((d, idx) => d.classList.toggle('on', idx === phase));
          if (iconPause && iconPlay) {
            iconPause.style.display = paused ? 'none' : '';
            iconPlay.style.display = paused ? '' : 'none';
          }
        };

        const stop = () => {
          if (timer !== undefined) {
            window.clearTimeout(timer);
            timer = undefined;
          }
        };

        const scheduleNext = () => {
          stop();
          if (paused) return;
          timer = window.setTimeout(() => {
            phase = (phase + 1) % durations.length;
            sync();
            scheduleNext();
          }, durations[phase] ?? 2000);
        };

        const ctrl: CinemaController = {
          start() {
            stop();
            paused = false;
            phase = 0;
            sync();
            scheduleNext();
          },
          stop,
          toggle() {
            paused = !paused;
            sync();
            if (paused) stop();
            else scheduleNext();
          },
          replay() {
            this.start();
          },
        };

        el.querySelector('[data-cinema-toggle]')?.addEventListener('click', (e) => {
          e.stopPropagation();
          ctrl.toggle();
        });
        el.querySelector('[data-cinema-replay]')?.addEventListener('click', (e) => {
          e.stopPropagation();
          ctrl.replay();
        });

        const hostSlide = el.closest<HTMLElement>('.slide');
        if (hostSlide) cinemas.set(hostSlide, ctrl);
      }

      function goTo(index: number, updateHash = true) {
        const next = Math.max(0, Math.min(total - 1, index));
        const prevSlide = slides[current];
        if (prevSlide && prevSlide !== slides[next]) {
          cinemas.get(prevSlide)?.stop();
        }
        current = next;
        slides.forEach((slide, i) => {
          slide.dataset.state = i === current ? 'active' : i < current ? 'past' : 'future';
        });
        if (counter) {
          counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
        }
        if (progressBar) {
          progressBar.style.width = `${((current + 1) / total) * 100}%`;
        }
        if (btnPrev) btnPrev.disabled = current === 0;
        if (btnNext) btnNext.disabled = current === total - 1;
        jumpButtons.forEach((b, i) => {
          b.dataset.current = String(i === current);
        });
        if (updateHash) {
          history.replaceState(null, '', `#${current + 1}`);
        }
        cinemas.get(slides[current])?.start();
      }

      function syncFromHash() {
        const hashNum = Number.parseInt(window.location.hash.replace('#', ''), 10);
        goTo(Number.isFinite(hashNum) && hashNum >= 1 && hashNum <= total ? hashNum - 1 : 0, false);
      }

      function toggleOverview(force?: boolean) {
        if (!overview) return;
        overview.dataset.open = String(force ?? overview.dataset.open !== 'true');
      }

      syncFromHash();
      window.addEventListener('hashchange', syncFromHash);

      document.getElementById('btn-prev')?.addEventListener('click', () => goTo(current - 1));
      document.getElementById('btn-next')?.addEventListener('click', () => goTo(current + 1));
      document.getElementById('edge-prev')?.addEventListener('click', () => goTo(current - 1));
      document.getElementById('edge-next')?.addEventListener('click', () => goTo(current + 1));
      document.getElementById('btn-grid')?.addEventListener('click', () => toggleOverview());
      document.getElementById('btn-overview-close')?.addEventListener('click', () => toggleOverview(false));
      document.getElementById('btn-full')?.addEventListener('click', () => {
        if (document.fullscreenElement) void document.exitFullscreen();
        else void document.documentElement.requestFullscreen();
      });

      jumpButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = Number.parseInt(btn.dataset.jump || '1', 10) - 1;
          toggleOverview(false);
          goTo(target);
        });
      });

      window.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const overviewOpen = overview?.dataset.open === 'true';
        if (e.key === 'Escape' && overviewOpen) {
          e.preventDefault();
          toggleOverview(false);
          return;
        }
        if (e.key === 'g' || e.key === 'G') {
          e.preventDefault();
          toggleOverview();
          return;
        }
        if (overviewOpen) return;

        if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ' || e.key === 'PageDown') {
          e.preventDefault();
          goTo(current + 1);
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp' || e.key === 'PageUp') {
          e.preventDefault();
          goTo(current - 1);
        } else if (e.key === 'Home') {
          e.preventDefault();
          goTo(0);
        } else if (e.key === 'End') {
          e.preventDefault();
          goTo(total - 1);
        } else if (e.key === 'f' || e.key === 'F') {
          e.preventDefault();
          if (document.fullscreenElement) void document.exitFullscreen();
          else void document.documentElement.requestFullscreen();
        } else if (e.key === 'r' || e.key === 'R') {
          cinemas.get(slides[current])?.replay();
        } else if (e.key === 't' || e.key === 'T') {
          const root = document.documentElement;
          root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
        }
      });

      let touchStartX = 0;
      let touchStartY = 0;
      window.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0]?.clientX || 0;
        touchStartY = e.changedTouches[0]?.clientY || 0;
      }, { passive: true });
      window.addEventListener('touchend', (e) => {
        if (overview?.dataset.open === 'true') return;
        const dx = (e.changedTouches[0]?.clientX || 0) - touchStartX;
        const dy = (e.changedTouches[0]?.clientY || 0) - touchStartY;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          goTo(dx < 0 ? current + 1 : current - 1);
        }
      }, { passive: true });

      let idleTimer: number | undefined;
      function wakeHud() {
        document.body.classList.remove('hud-idle');
        window.clearTimeout(idleTimer);
        idleTimer = window.setTimeout(() => document.body.classList.add('hud-idle'), 2200);
      }
      window.addEventListener('mousemove', wakeHud, { passive: true });
      wakeHud();
    </script>
  </body>
</html>
