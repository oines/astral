---
import { ArrowRight, ArrowUpRight, BookOpen, Plus } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import WorkflowDemo from './WorkflowDemo.astro';
import GroupChatDemo from './GroupChatDemo.astro';
import { docPath, repository, coreRepository, type Locale } from '../lib/site';
import '../styles/landing.css';
const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh-cn';
const t = zh ? {
  title: 'Astral — 一个 Agent，在你的所有电脑上工作',
  description: 'Astral 是开源、可自托管的个人 Agent。在同一个 Session 中跨电脑完成任务，也能从聊天软件发起任务、接收结果。',
  kind: '开源个人 Agent', headline: ['一个 Agent，', '在你的所有电脑上工作。'],
  intro: '属于你的个人 AI 助手，\n在你掌控的电脑之间开展工作。',
  detail: '在同一个 Session 中读写文件、调用工具，跨电脑完成任务。',
  get: '获取 Astral', github: '在 GitHub 上查看', meta: ['开源', '可自托管', 'macOS / Windows / Linux'],
  workTitle: '一个 Session，\n跨多台电脑执行。',
  workIntro: '你的 MacBook、台式机、家里的服务器。',
  workBody: 'Session 保存任务的上下文。读取 MacBook 上的文件、使用服务器上的工具、在台式机上运行命令，都可以在同一个 Session 中完成。',
  workLink: '了解跨电脑工作',
  chatTitle: '把 Astral 带进你的聊天。',
  chatBody: '在 Telegram、QQ、微信或飞书里交代任务，让它使用你的电脑完成任务，再把结果发回聊天。',
  groupTitle: '群里也能一起推进任务。',
  groupBody: '群成员可以 @ Astral 提出任务、补充要求。默认通过 @ 或回复唤起，也可开启主动参与，让它根据收到的讨论判断是否加入。',
  chatSupport: 'Telegram、QQ 和飞书支持群聊，微信目前仅支持私聊。',
  chatLink: '连接聊天平台',
  setupTitle: '从任务开始。',
  folderTitle: '不用先建工作区。', folderBody: '直接说你想做什么。Astral 可以根据任务查找目录、了解环境，找到需要使用的文件和工具。',
  toolsTitle: '用上电脑里已有的工具。', toolsBody: '命令行工具、脚本和 API。让 Agent 调用你已经安装和配置好的软件，把现有的工作环境用起来。',
  runTitle: '在桌面或服务器上运行。', runIntro: '从自己的电脑开始，需要时再连接更多机器。',
  desktopTitle: '从桌面版开始', desktopBody: '安装 Astral，连接模型，选择一台电脑。桌面应用会管理本地运行服务，你可以专注于手上的工作。', desktopLink: '桌面版与构建指南',
  serverTitle: '部署到自己的服务器', serverBody: '在自己的硬件上运行 Astral Server，通过自己的网络连接其他电脑，使用浏览器访问同一个工作环境。', serverLink: '阅读部署文档',
  coreTitle: '开放的 Agent Harness。', coreBody: 'Astral 的核心管理 Session 和工具调用，通过已连接的电脑执行任务。你可以查看实现、自己运行，或按需修改。', architecture: '了解运行方式', source: '阅读源码',
  lastFirst: '你的电脑已经就绪。', lastSecond: '给它们一个 Agent。',
  docs: '从文档开始', faqTitle: '开始前，你可能想了解',
  faqs: [
    ['Astral 自带 AI 模型吗？', 'Astral 提供 Agent 的运行环境，你需要连接自己的模型服务。首次配置会引导你选择模型和电脑。'],
    ['需要先安装 Docker 吗？', '使用本机或接入其他电脑不需要 Docker。选择容器作为执行环境时，才需要对应机器上的 Docker 兼容运行时。'],
    ['连接电脑后，文件会自动同步吗？', '不会。文件保留在各自的电脑上。同一个 Session 可以使用多台电脑，但不会自动复制文件或迁移已有进程。'],
    ['现在可以下载吗？', '项目源码已公开，正式安装包仍在准备中。“获取 Astral”页面提供当前发布状态与源码构建步骤。'],
  ],
} : {
  title: 'Astral — One agent. All your computers.',
  description: 'An open-source personal AI agent. Work across your computers in one session, or send tasks and receive results through your chat apps.',
  kind: 'Open-source personal agent', headline: ['One agent.', 'All your computers.'],
  intro: 'Your own personal AI agent, built to work\nacross the computers you control.',
  detail: 'Read files and run tools across computers, all within one session.',
  get: 'Get Astral', github: 'View on GitHub', meta: ['Open source', 'Self-hosted', 'macOS / Windows / Linux'],
  workTitle: 'One session.\nAcross computers.',
  workIntro: 'Your MacBook. Your desktop. Your home server.',
  workBody: 'A session holds the context for your task. Read files on your MacBook, use tools on your server, and run commands on your desktop, all within that same session.',
  workLink: 'Explore cross-computer work',
  chatTitle: 'Bring Astral into your chats.',
  chatBody: 'Give it a task in Telegram, QQ, WeChat, or Feishu. Let it use your computers to get the work done and send the results back to the chat.',
  groupTitle: 'Work on it together in a group.',
  groupBody: 'Group members can mention Astral to request work or add details. Mentions and replies wake it by default. You can also enable proactive participation so it can decide when to join a discussion.',
  chatSupport: 'Telegram, QQ, and Feishu support groups. WeChat currently supports private chats only.',
  chatLink: 'Connect a chat platform',
  setupTitle: 'Start with the task.',
  folderTitle: 'No workspace to set up.', folderBody: 'Start with what you want done. Astral can navigate folders and connected computers to find the files and tools the task needs.',
  toolsTitle: 'Use the tools you already have.', toolsBody: 'Command-line tools, scripts, and APIs. Let your agent work with the software already installed and configured on your computers.',
  runTitle: 'On your desktop or server.', runIntro: 'Start on your computer. Connect more machines when you need them.',
  desktopTitle: 'Start with Desktop', desktopBody: 'Install Astral, connect a model, and choose a computer. The desktop app manages the local runtime, so you can focus on the work.', desktopLink: 'Desktop & build guide',
  serverTitle: 'Run it on your own server', serverBody: 'Run Astral Server on your hardware. Connect other computers through your own network, and open your workspace in a browser.', serverLink: 'Read the deployment guide',
  coreTitle: 'An open agent harness.', coreBody: 'Astral’s core manages sessions and tool calls, executing work on connected computers. Read the implementation, run it yourself, or adapt it to your needs.', architecture: 'How Astral runs', source: 'Read the source',
  lastFirst: 'Your computers are ready.', lastSecond: 'Give them an agent.',
  docs: 'Start with the docs', faqTitle: 'A few things to know',
  faqs: [
    ['Does Astral include an AI model?', 'Astral provides the agent runtime. You connect your own model service. The first-run setup walks you through choosing a model and a computer.'],
    ['Do I need Docker?', 'Not for your local computer or another native machine. A Docker-compatible runtime is only needed when you choose a container as the execution environment.'],
    ['Are files synced between computers?', 'No. Files stay on their source computer. One session can use several computers, but does not automatically copy files or move existing processes.'],
    ['Can I download Astral today?', 'The source is public. Public installers are still in preparation. The Get Astral page has the current availability and source-build instructions.'],
  ],
};
---
<SiteLayout locale={locale} title={t.title} description={t.description}>
  <section class:list={['hero', 'site-width', { 'hero-zh': zh }]} id="product">
    <p class="product-kind">{t.kind}</p>
    <h1><span>{t.headline[0]}</span><span>{t.headline[1]}</span></h1>
    <p class="hero-intro">{t.intro}</p>
    <p class="hero-detail">{t.detail}</p>
    <div class="hero-actions"><a href={docPath(locale, 'start/get-astral')} class="button button-primary">{t.get}<ArrowRight /></a><a href={repository} class="button" target="_blank" rel="noopener noreferrer">{t.github}<ArrowUpRight size={16} /></a></div>
    <ul class="hero-meta" aria-label={zh ? '平台与部署方式' : 'Platforms and deployment'}>{t.meta.map(item => <li>{item}</li>)}</ul>
  </section>
  <div class="site-width demo-wrap"><WorkflowDemo locale={locale} /></div>

  <section class="section site-width work-section" aria-labelledby="work-heading">
    <div class="section-heading"><h2 id="work-heading">{t.workTitle}</h2></div>
    <div class="section-copy"><p class="section-lead">{t.workIntro}</p><p>{t.workBody}</p><a class="text-link" href={docPath(locale, 'computers/across-computers')}>{t.workLink}<ArrowRight /></a></div>
  </section>

  <section class="section site-width chat-section" id="chat" aria-labelledby="chat-heading">
    <div class="chat-copy section-copy">
      <h2 id="chat-heading">{t.chatTitle}</h2>
      <p class="chat-intro">{t.chatBody}</p>
      <h3>{t.groupTitle}</h3>
      <p>{t.groupBody}</p>
      <p class="chat-support">{t.chatSupport}</p>
      <a class="text-link" href={docPath(locale, 'chat/overview')}>{t.chatLink}<ArrowRight /></a>
    </div>
    <GroupChatDemo locale={locale} />
  </section>

  <section class="section site-width setup-section" aria-labelledby="setup-heading">
    <div class="section-heading"><h2 id="setup-heading">{t.setupTitle}</h2></div>
    <div class="feature-list">
      <article><div><h3>{t.folderTitle}</h3><p>{t.folderBody}</p></div></article>
      <article><div><h3>{t.toolsTitle}</h3><p>{t.toolsBody}</p></div></article>
    </div>
  </section>

  <section class="run-section" aria-labelledby="run-heading"><div class="site-width">
    <h2 id="run-heading">{t.runTitle}</h2><p class="run-intro">{t.runIntro}</p>
    <div class="run-options">
      <article><h3>{t.desktopTitle}</h3><p>{t.desktopBody}</p><a class="text-link" href={docPath(locale, 'start/get-astral')}>{t.desktopLink}<ArrowRight /></a></article>
      <article><h3>{t.serverTitle}</h3><p>{t.serverBody}</p><a class="text-link" href={docPath(locale, 'hosting/server')}>{t.serverLink}<ArrowRight /></a></article>
    </div>

  </div></section>

  <section class="section site-width core-section" aria-labelledby="core-heading">
    <div class="section-heading"><h2 id="core-heading">{t.coreTitle}</h2></div>
    <div class="section-copy"><p>{t.coreBody}</p><div class="inline-links"><a class="text-link" href={docPath(locale, 'hosting/architecture')}>{t.architecture}<ArrowRight /></a><a class="text-link" href={coreRepository} target="_blank" rel="noopener noreferrer">{t.source}<ArrowUpRight /></a></div></div>
  </section>

  <section class="site-width faq-section" aria-labelledby="faq-heading"><h2 id="faq-heading">{t.faqTitle}</h2><div class="faq-list">{t.faqs.map(([q,a]) => <details><summary>{q}<Plus size={17} stroke-width={1.4} /></summary><p>{a}</p></details>)}</div></section>

  <section class="closing site-width"><h2><span>{t.lastFirst}</span><span>{t.lastSecond}</span></h2><div class="hero-actions"><a href={docPath(locale, 'start/get-astral')} class="button button-primary">{t.get}<ArrowRight /></a><a href={docPath(locale)} class="text-link"><BookOpen size={16} />{t.docs}</a></div></section>
</SiteLayout>
