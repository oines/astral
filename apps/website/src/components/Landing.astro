---
import { ArrowRight, ArrowUpRight, BookOpen, Check, Clock, Copy, GitFork, Layers, Plus, RefreshCw, ShieldCheck } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import WorkflowDemo from './WorkflowDemo.astro';
import GroupChatDemo from './GroupChatDemo.astro';
import { docPath, repository, coreRepository, releasesUrl, type Locale } from '../lib/site';
import '../styles/landing.css';
const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh-cn';
const serverCommand = "curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' https://github.com/oines/astral/releases/latest/download/install-server.sh | bash";
const t = zh ? {
  title: 'Astral — 一个 Agent，在你的所有电脑上工作',
  description: 'Astral 是开源、可自托管的个人 Agent。在同一个 Session 中跨电脑完成任务，也能从聊天软件发起任务、接收结果。',
  version: 'v0.1.45',
  kind: '开源个人 Agent', headline: ['一个 Agent，', '在你的所有电脑上工作。'],
  intro: '一次对话串联你的笔记本、台式机和服务器。\n文件留在原地，结果发回手里。',
  get: '下载 Astral', github: '在 GitHub 上查看', meta: ['开源 · AGPL-3.0', '可自托管', 'macOS / Windows / Linux'],
  workTitle: '一个 Session，\n跨多台电脑执行。',
  workIntro: '你的 MacBook、台式机，还有家里的服务器。',
  workBody: '上下文留在同一个 Session 里，文件和环境留在各自的电脑上。哪一步适合在哪台机器做，Astral 就直接在哪台机器上动手。',
  workLink: '了解跨电脑工作',
  folderTitle: '从任务开始，不用先搭工作区', folderBody: '直接说想做什么。Astral 会自己找目录、看项目说明，找到需要的文件和脚本。',
  toolsTitle: '直接用你装好的工具', toolsBody: '命令行、脚本、现有代码库和本机软件都能直接调用，不用把习惯的工作流搬进新沙盒。',
  chatTitle: '把 Astral 带进你的聊天。',
  chatBody: '在 Telegram、QQ、微信或飞书里交代任务，让它使用你的电脑完成任务，再把结果发回聊天。',
  groupTitle: '群里也能一起推进任务。',
  groupBody: '群成员可以 @ Astral 交代任务或补充细节。默认只在被 @ 或回复时回应；需要时也可开启主动参与，让它自行判断何时加入讨论。',
  chatSupport: 'Telegram、QQ 和飞书支持群聊，微信目前仅支持私聊。',
  chatLink: '连接聊天平台',
  capTitle: '不止一问一答。',
  capIntro: '长任务放去后台，例行工作交给时间与事件，顺手的做法留给下次。',
  capabilities: [
    { icon: GitFork, title: '耗时任务交给后台', body: '把能并行处理的部分拆给子代理，主会话照常对话，随时点开查看过程和结果。', target: 'usage/conversations#把耗时工作交给子代理', link: '了解子代理' },
    { icon: Clock, title: '按时跑，也能随事触发', body: '定时整理周报或检查待办；也能接入本机脚本或服务事件，有变动时自动唤醒会话继续处理。', target: 'usage/schedules', link: '了解计划与唤醒' },
    { icon: Layers, title: '写一次方法，所有电脑通用', body: '把常用做法存成技能，在当前电脑验证后，一键同步到你连接的其他机器。', target: 'usage/skills', link: '了解共享技能' },
    { icon: RefreshCw, title: '模型限流时自动顶上', body: '按偏好排好候选模型，首选遇到限流或服务波动时自动切换，手上的任务不中断。', target: 'usage/models', link: '了解模型设置' },
  ],
  coreTitle: '设计克制，边界清楚。',
  coreIntro: '让 Agent 直接用好真实电脑，少一层多余抽象，多一分实际掌控。',
  corePoints: [
    ['极简的 Harness', '只保留少量基础工具，让 Agent 直接使用电脑上的文件、命令和软件。'],
    ['强大的内置 API', '历史查询、计划任务、聊天管理与文件操作，按任务需要自主发现和调用。'],
    ['高缓存命中率', '上下文结构保持稳定，连续工作充分复用模型缓存，减少重复输入开销。'],
  ],
  safetyTitle: '权限与隐私由你掌控',
  safetyItems: [
    '按 Bot 单独授权电脑，只开放你选中的机器',
    '公开群聊可配专用 Bot 与 Docker 容器隔离',
    '个人任务可设为私密会话，不对其他会话开放',
    '直连你自己的模型服务与 API Key',
  ],
  safetyLink: '了解权限与隐私',
  architecture: '了解运行方式', source: '阅读 Core 源码',
  runTitle: '在桌面或服务器上运行。', runIntro: '先在自己电脑上用起来；需要全天在线时，再部署到服务器。',
  desktopTag: 'macOS · Windows · Linux',
  desktopTitle: '桌面版，打开即用', desktopBody: '下载安装包，连上模型、选中本机即可开始，本地服务随应用自动管理。', desktopFormats: ['macOS · DMG', 'Windows · EXE', 'Linux · AppImage / DEB'], desktopLink: '选择平台并下载',
  serverTag: 'Linux x86_64 / ARM64 · systemd',
  serverTitle: 'Linux Server，全天在线', serverBody: '在自己的 Linux 服务器上一行命令部署，浏览器随时访问，聊天连接和计划任务全天在线。', serverLink: '查看完整服务器指南',
  copy: '复制', copied: '已复制',
  lastFirst: '你的电脑已经就绪。', lastSecond: '给它们一个 Agent。',
  docs: '阅读文档', releases: '更新日志', faqTitle: '开始前，你可能想了解',
  faqs: [
    ['授权电脑后，权限和隐私怎么控制？', '电脑访问权限按 Bot 单独授予，每个助手只能使用你允许的机器。公开群聊可以建一个专用 Bot 并搭配 Docker 容器隔离环境；个人工作还可以设为私密会话，不对其他会话开放检索。'],
    ['Astral 自带 AI 模型吗？', '不自带。Astral 提供 Agent 运行环境，你可以直接连接自己的模型服务，支持 API Key、账号登录或自定义兼容地址。首次启动引导会带你完成配置。'],
    ['需要先安装 Docker 吗？', '使用本机或接入其他普通电脑不需要 Docker。只有当你希望把某个 Bot 隔离在容器里运行时，才需要在对应机器准备 Docker 兼容运行时。'],
    ['连接电脑后，文件会自动同步吗？', '不会。文件始终留在各自所在的电脑上。同一个 Session 可以调用多台电脑协作，但不会自动复制文件或迁移正在运行的进程。'],
  ],
} : {
  title: 'Astral — One agent. All your computers.',
  description: 'An open-source personal AI agent. Work across your computers in one session, or send tasks and receive results through your chat apps.',
  version: 'v0.1.45',
  kind: 'Open-source personal agent', headline: ['One agent.', 'All your computers.'],
  intro: 'One session across your laptop, desktop, and servers.\nFiles stay where they live; results come back to you.',
  get: 'Download Astral', github: 'View on GitHub', meta: ['Open source · AGPL-3.0', 'Self-hosted', 'macOS / Windows / Linux'],
  workTitle: 'One session.\nAcross computers.',
  workIntro: 'Your MacBook, your desktop, and your home server.',
  workBody: 'The conversation stays in one session while files and environments stay on their own machines. Astral simply works on whichever computer fits the step.',
  workLink: 'Explore cross-computer work',
  folderTitle: 'Start with the task, not a workspace', folderBody: 'Say what you need done. Astral finds the right folder, reads your project notes, and locates the files and scripts itself.',
  toolsTitle: 'Use the tools you already have', toolsBody: 'CLI tools, scripts, existing repos, and local apps work as they are—no need to rebuild your setup inside a new sandbox.',
  chatTitle: 'Bring Astral into your chats.',
  chatBody: 'Give it a task in Telegram, QQ, WeChat, or Feishu. Let it use your computers to get the work done and send the results back to the chat.',
  groupTitle: 'Work on it together in a group.',
  groupBody: 'Group members can mention Astral to kick off a task or add details. Mentions and replies wake it by default; you can also turn on proactive participation so it decides when to chime in.',
  chatSupport: 'Telegram, QQ, and Feishu support groups. WeChat currently supports private chats only.',
  chatLink: 'Connect a chat platform',
  capTitle: 'More than one-off prompts.',
  capIntro: 'Send long work to the background, let schedules and events take over routines, and keep useful methods reusable.',
  capabilities: [
    { icon: GitFork, title: 'Send heavy work to the background', body: 'Delegate parallel or slow steps to subagents while you keep talking in the main thread, with live steps and results on the side.', target: 'usage/conversations#delegate-background-work', link: 'Explore subagents' },
    { icon: Clock, title: 'Run on a schedule—or on events', body: 'Automate recurring check-ins, or let local scripts and services wake a session through a localhost endpoint when something changes.', target: 'usage/schedules', link: 'Explore schedules & events' },
    { icon: Layers, title: 'Write a method once, share everywhere', body: 'Save repeatable workflows as skills, test them locally, and sync the published version across every connected computer.', target: 'usage/skills', link: 'Explore shared skills' },
    { icon: RefreshCw, title: 'Keep moving when a model stalls', body: 'Set an ordered list of models per Bot so rate limits or outages fall back automatically without breaking your session.', target: 'usage/models', link: 'Explore model setup' },
  ],
  coreTitle: 'Lean by design. Clear by default.',
  coreIntro: 'Let the agent work directly on real machines—fewer layers in the middle, more control in your hands.',
  corePoints: [
    ['A minimal harness', 'A small set of core tools lets the agent work directly with files, commands, and software on your computers.'],
    ['Powerful built-in APIs', 'History, scheduling, chat, and file APIs stay out of the way until a task calls for them.'],
    ['High cache hit rates', 'A steady context structure lets ongoing work reuse the model’s prompt cache and avoid paying for repeated input.'],
  ],
  safetyTitle: 'Permissions and privacy stay in your hands',
  safetyItems: [
    'Computer access is granted per Bot—only approved machines are reachable',
    'Public group chats can run on a dedicated Bot inside a Docker container',
    'Personal tasks can be marked private and hidden from other sessions',
    'Connect directly to your own model providers and API keys',
  ],
  safetyLink: 'Read permissions & privacy',
  architecture: 'How Astral runs', source: 'Read Core source',
  runTitle: 'On your desktop or server.', runIntro: 'Start on your own machine, and move to a server when you want it online around the clock.',
  desktopTag: 'macOS · Windows · Linux',
  desktopTitle: 'Desktop app, ready out of the box', desktopBody: 'Install the package, connect a model, and pick your computer. The app manages its local runtime for you.', desktopFormats: ['macOS · DMG', 'Windows · EXE', 'Linux · AppImage / DEB'], desktopLink: 'Choose your platform',
  serverTag: 'Linux x86_64 / ARM64 · systemd',
  serverTitle: 'Linux Server, always online', serverBody: 'Deploy on your own Linux server with one command, open it in any browser, and keep chats and schedules running nonstop.', serverLink: 'Read the server guide',
  copy: 'Copy', copied: 'Copied',
  lastFirst: 'Your computers are ready.', lastSecond: 'Give them an agent.',
  docs: 'Read the docs', releases: 'Releases', faqTitle: 'A few things to know',
  faqs: [
    ['How are permissions and privacy controlled?', 'Computer access is granted per Bot, so each assistant only reaches the machines you allow. For public group chats, create a dedicated Bot backed by a Docker container. Personal work can also be marked private so other sessions cannot look it up.'],
    ['Does Astral include an AI model?', 'No. Astral provides the agent runtime while you connect your own model service via API key, supported account login, or a custom compatible endpoint. First-run setup walks you through it.'],
    ['Do I need Docker?', 'Not for your own computer or another native machine. A Docker-compatible runtime is only needed when you want an isolated container environment for a Bot.'],
    ['Are files synced between computers?', 'No. Files stay on their source computer. One session can use several computers, but does not automatically copy files or move existing processes.'],
  ],
};
---
<SiteLayout locale={locale} title={t.title} description={t.description}>
  <section class:list={['hero', 'site-width', { 'hero-zh': zh }]} id="product">
    <a class="hero-eyebrow" href={releasesUrl} target="_blank" rel="noopener noreferrer">
      <span class="hero-eyebrow-version">{t.version}</span>
      <span class="hero-eyebrow-sep" aria-hidden="true"></span>
      <span>{t.kind}</span>
      <ArrowUpRight size={13} aria-hidden="true" />
    </a>
    <h1><span>{t.headline[0]}</span><span>{t.headline[1]}</span></h1>
    <p class="hero-intro">{t.intro}</p>
    <div class="hero-actions"><a href={docPath(locale, 'start/get-astral')} class="button button-primary">{t.get}<ArrowRight /></a><a href={repository} class="button" target="_blank" rel="noopener noreferrer">{t.github}<ArrowUpRight size={15} /></a></div>
    <ul class="hero-meta" aria-label={zh ? '平台与部署方式' : 'Platforms and deployment'}>{t.meta.map(item => <li>{item}</li>)}</ul>
  </section>
  <div class="site-width demo-wrap"><WorkflowDemo locale={locale} /></div>

  <section class="section site-width work-section" aria-labelledby="work-heading">
    <div class="section-heading section-copy">
      <h2 id="work-heading">{t.workTitle}</h2>
      <p class="section-lead">{t.workIntro}</p>
      <p>{t.workBody}</p>
      <a class="text-link" href={docPath(locale, 'computers/across-computers')}>{t.workLink}<ArrowRight /></a>
    </div>
    <div class="feature-list">
      <article><h3>{t.folderTitle}</h3><p>{t.folderBody}</p></article>
      <article><h3>{t.toolsTitle}</h3><p>{t.toolsBody}</p></article>
    </div>
  </section>

  <section class="section site-width chat-section" id="chat" aria-labelledby="chat-heading">
    <div class="chat-copy section-copy">
      <h2 id="chat-heading">{t.chatTitle}</h2>
      <p class="chat-intro">{t.chatBody}</p>
      <h3>{t.groupTitle}</h3>
      <p>{t.groupBody}</p>
      <p class="chat-support">{t.chatSupport}</p>
      <a class="text-link" href={docPath(locale, 'chat/overview')}>{t.chatLink}<ArrowRight /></a>
    </div>
    <GroupChatDemo locale={locale} />
  </section>

  <section class="band-section site-width capabilities-section" aria-labelledby="cap-heading">
    <div class="band-header">
      <h2 id="cap-heading">{t.capTitle}</h2>
      <p>{t.capIntro}</p>
    </div>
    <div class="capabilities-grid">
      {t.capabilities.map((item) => {
        const [page, hash] = item.target.split('#');
        const href = `${docPath(locale, page)}${hash ? `#${hash}` : ''}`;
        const Icon = item.icon;
        return (
          <article class="capability-item">
            <span class="capability-icon" aria-hidden="true"><Icon size={16} stroke-width={1.6} /></span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <a class="text-link" href={href}>{item.link}<ArrowRight /></a>
          </article>
        );
      })}
    </div>
  </section>

  <section class="band-section site-width core-section" aria-labelledby="core-heading">
    <div class="band-header band-header-split">
      <div>
        <h2 id="core-heading">{t.coreTitle}</h2>
        <p>{t.coreIntro}</p>
      </div>
      <div class="inline-links">
        <a class="text-link" href={docPath(locale, 'hosting/architecture')}>{t.architecture}<ArrowRight /></a>
        <a class="text-link" href={coreRepository} target="_blank" rel="noopener noreferrer">{t.source}<ArrowUpRight /></a>
      </div>
    </div>
    <div class="core-columns">
      {t.corePoints.map(([title, body]) => (
        <article>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
    <div class="safety-band">
      <div class="safety-band-head">
        <h3><ShieldCheck size={16} stroke-width={1.6} aria-hidden="true" />{t.safetyTitle}</h3>
        <a class="text-link" href={docPath(locale, 'start/safe-use')}>{t.safetyLink}<ArrowRight /></a>
      </div>
      <ul>
        {t.safetyItems.map(item => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="run-section" aria-labelledby="run-heading"><div class="site-width">
    <h2 id="run-heading">{t.runTitle}</h2><p class="run-intro">{t.runIntro}</p>
    <div class="run-options">
      <article class="run-option">
        <p class="run-tag">{t.desktopTag}</p>
        <h3>{t.desktopTitle}</h3>
        <p>{t.desktopBody}</p>
        <ul class="platform-pills" aria-label={zh ? '支持的桌面安装包格式' : 'Available desktop formats'}>
          {t.desktopFormats.map(item => <li>{item}</li>)}
        </ul>
        <a class="text-link" href={docPath(locale, 'start/get-astral')}>{t.desktopLink}<ArrowRight /></a>
      </article>
      <article class="run-option">
        <p class="run-tag">{t.serverTag}</p>
        <h3>{t.serverTitle}</h3>
        <p>{t.serverBody}</p>
        <div class="command-snippet">
          <code data-server-command>{serverCommand}</code>
          <button type="button" class="copy-button" data-copy-server data-copy-label={t.copy} data-copied-label={t.copied} aria-label={t.copy}>
            <Copy class="copy-icon" size={13} aria-hidden="true" />
            <Check class="copied-icon" size={13} aria-hidden="true" />
            <span data-copy-text>{t.copy}</span>
          </button>
        </div>
        <a class="text-link" href={docPath(locale, 'hosting/server')}>{t.serverLink}<ArrowRight /></a>
      </article>
    </div>
  </div></section>

  <section class="site-width faq-section" aria-labelledby="faq-heading"><h2 id="faq-heading">{t.faqTitle}</h2><div class="faq-list">{t.faqs.map(([q,a]) => <details><summary>{q}<Plus size={17} stroke-width={1.4} /></summary><p>{a}</p></details>)}</div></section>

  <section class="closing site-width"><h2><span>{t.lastFirst}</span><span>{t.lastSecond}</span></h2><div class="hero-actions"><a href={docPath(locale, 'start/get-astral')} class="button button-primary">{t.get}<ArrowRight /></a><a href={docPath(locale)} class="text-link"><BookOpen size={15} />{t.docs}</a><a href={releasesUrl} class="text-link" target="_blank" rel="noopener noreferrer">{t.releases}<ArrowUpRight size={15} /></a></div></section>
</SiteLayout>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-server]');
  const code = document.querySelector<HTMLElement>('[data-server-command]');
  if (button && code) {
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.textContent || '');
        const text = button.querySelector<HTMLElement>('[data-copy-text]');
        if (text) text.textContent = button.dataset.copiedLabel || 'Copied';
        button.setAttribute('data-copied', 'true');
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          if (text) text.textContent = button.dataset.copyLabel || 'Copy';
          button.removeAttribute('data-copied');
        }, 1800);
      } catch { /* Clipboard may be unavailable in restricted contexts. */ }
    });
  }
</script>
